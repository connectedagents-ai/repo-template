# AI provider APIs: references only, never values. Load with:
#   op run --env-file=ops/env/ai-apis.env.example -- <cmd>
# Vault "AI-Agents" holds only what agents need (see ops/mcp/README.md §3). One key per environment (dev / ci / prod).

# Anthropic: Claude API, Claude Agent SDK, Claude Code headless (`claude -p`)
ANTHROPIC_API_KEY=op://AI-Agents/Anthropic-dev/credential

# OpenAI: API, Agents SDK, Codex CLI in API-key mode
OPENAI_API_KEY=op://AI-Agents/OpenAI-dev/credential
OPENAI_ORG_ID=op://AI-Agents/OpenAI-dev/org-id
OPENAI_PROJECT_ID=op://AI-Agents/OpenAI-dev/project-id

# xAI: Grok API (OpenAI-compatible at https://api.x.ai/v1), Grok CLI in API-key mode
XAI_API_KEY=op://AI-Agents/xAI-dev/credential
XAI_BASE_URL=https://api.x.ai/v1
